ENV=dev
PORT=3000
HOST=http://localhost
DB_URL=----db_connection_string----
LLM_HOST_API=----llm_host_api_key----
LLM_HOST=----llm_host_url----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Web tool tuning (optional — defaults shown)
# WEB_SEARCH_TIMEOUT_MS=30000
# FETCH_TIMEOUT_MS=30000
# WEB_SEARCH_MAX_RESULTS_DEFAULT=10
# WEB_SEARCH_MAX_RESULTS_MAX=10
# Read directly by quack-search; set when its native binary cannot be auto-resolved
# QUACK_BINARY_PATH=
